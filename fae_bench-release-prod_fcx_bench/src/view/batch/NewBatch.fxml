<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="root" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.batch.NewBatchControllerView">
   <children>
      <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
         <bottom>
            <ToolBar maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="40.0" BorderPane.alignment="CENTER">
              <items>
                <Button fx:id="btAction" mnemonicParsing="false" onAction="#onActionSalvar" prefWidth="200.0" text="Salvar" />
                  <Label fx:id="labelUserMsg" text="* Todos os campos são obrigatórios" textFill="RED">
                     <font>
                        <Font name="System Bold Italic" size="12.0" />
                     </font>
                     <padding>
                        <Insets left="30.0" />
                     </padding>
                  </Label>
              </items>
               <BorderPane.margin>
                  <Insets left="5.0" />
               </BorderPane.margin>
            </ToolBar>
         </bottom>
         <center>
            <HBox spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox styleClass="bordered-titled-border" stylesheets="@../css/generalStyleSheet.css" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <VBox spacing="10.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="150.0" text="Número do Lote" />
                                    <TextField fx:id="tfBatchNum" alignment="CENTER" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="150.0" text="Descrição" />
                                    <TextField fx:id="tfDescription" minWidth="600.0" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="150.0" text="Número de série Inicial" />
                                    <TextField fx:id="tfStartSeq" alignment="CENTER" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="150.0" text="Qtd de medidores" />
                                    <TextField fx:id="tfNumberOfMeters" alignment="CENTER" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="150.0" text="Ano de fabricação do lote" />
                                    <TextField fx:id="tfYearManufacture" alignment="CENTER" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="150.0" text="Código do fabricante" />
                                    <TextField fx:id="tfManufacturerCode" alignment="CENTER" editable="false" text="F" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="150.0" text="Cliente" />
                                    <ComboBox fx:id="cbClient" prefWidth="300.0" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="150.0" text="Tipo de medidor" />
                                    <ComboBox fx:id="cbMeterType" prefWidth="600.0" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0" VBox.vgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Label minWidth="150.0" text="Config. de processo" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" maxWidth="540.0" spacing="10.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label fx:id="lbLoadProcessConfig" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Button fx:id="btLoadProcessConfig" mnemonicParsing="false" onAction="#onLoadProcessConfig" prefWidth="50.0" text=". . . " />
                                       </children>
                                    </HBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox styleClass="bordered-titled-border" stylesheets="@../css/generalStyleSheet.css">
                     <children>
                        <VBox spacing="10.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="150.0" text="wM-Bus config.">
                                       <font>
                                          <Font name="System Bold" size="12.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="150.0" text="Número de série Inicial" />
                                    <TextField fx:id="tfStartSeqRadio" alignment="CENTER" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="150.0" text="Número do fabricante" />
                                    <TextField fx:id="tfManufacturerNumberRadio" alignment="CENTER" editable="false" text="2518" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="150.0" text="Cód. do produto" />
                                    <TextField fx:id="tfProductCodeRadio" alignment="CENTER" editable="false" text="07" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="150.0" text="Versão" />
                                    <TextField fx:id="tfVersionRadio" alignment="CENTER" editable="false" text="00" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="150.0" text="Intervalo de transmissão" />
                                    <TextField fx:id="tfTransmitIntervalRadio" alignment="CENTER" />
                                 </children>
                              </HBox>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
