<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.effect.*?>
<?import javafx.scene.control.*?>
<?import eu.hansolo.medusa.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="root" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.flowrate.LoadFlowRateControllerView">
   <children>
      <BorderPane layoutX="102.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <bottom>
            <ToolBar prefHeight="40.0" prefWidth="200.0">
              <items>
                  <Button fx:id="btAction" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onActionButton" prefWidth="200.0" text="Novo" textAlignment="CENTER" />
              </items>
            </ToolBar>
         </bottom>
         <center>
            <TableView id="batchTable" fx:id="flowRateTable" onMouseClicked="#onTableMouseClicked" styleClass="table-column-style" stylesheets="@../css/generalStyleSheet.css" tableMenuButtonVisible="true" BorderPane.alignment="CENTER">
              <columns>
                  <TableColumn fx:id="columnSelect" prefWidth="100.0" text="Select" />
                <TableColumn fx:id="columnFlowRate" prefWidth="100.0" text="Flowrate" />
                <TableColumn fx:id="columnDescription" prefWidth="450.0" text="Description" />
                  <TableColumn fx:id="columnUpperLimit" prefWidth="100.0" text="Upper limit" />
                  <TableColumn fx:id="columnLowerLimit" prefWidth="100.0" text="Lower limit" />
                  <TableColumn fx:id="columnRamal" prefWidth="100.0" text="Ramal" />
                  <TableColumn fx:id="columnRefMeter" prefWidth="100.0" text="Ref. meter" />
                  <TableColumn fx:id="columnPump" prefWidth="100.0" text="Pump" />
              </columns>
            </TableView>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
