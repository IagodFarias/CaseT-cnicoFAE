<BorderPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="400.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.matfile.MatFileChooser">
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox />
            <VBox spacing="20.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="20.0">
                     <children>
                        <Label text="Diretório:" />
                        <JFXTextField fx:id="tfMatFilePath" editable="false" HBox.hgrow="ALWAYS" />
                        <JFXButton fx:id="btBrowserMatFile" buttonType="RAISED" onAction="#onCaliConstFileChoose" prefHeight="30.0" prefWidth="60.0" styleClass="bordered-titled-title" stylesheets="@../css/generalStyleSheet.css" text="..." />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin></VBox>
   </center>
   <top>
      <HBox alignment="CENTER_RIGHT" spacing="300.0" styleClass="background-color-fae" stylesheets="@../css/generalStyleSheet.css" BorderPane.alignment="CENTER_RIGHT">
         <children>
            <Label text="MatFile">
               <font>
                  <Font name="System Bold Italic" size="12.0" />
               </font>
            </Label>
            <JFXButton fx:id="btClose" onAction="#onClose" prefHeight="20.0" prefWidth="40.0" styleClass="bordered-button-close" stylesheets="@../css/generalStyleSheet.css" text="X">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </JFXButton>
         </children>
         <padding>
            <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
         </padding>
      </HBox>
   </top>
</BorderPane>
